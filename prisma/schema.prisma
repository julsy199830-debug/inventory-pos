generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String
  /// Scrypt hash of the login PIN in the versioned wire format
  /// `scrypt$v1$N$r$p$saltHex$hashHex` produced by `hashPin` in
  /// `src/lib/pin.ts`, and verified with the dedicated `verifyPin`
  /// (timing-safe recomputation — never plain equality). REQUIRED: every
  /// account's only login credential since the plaintext retirement
  /// (`retire_plaintext_pin`); the former plaintext `pin` column is gone.
  /// The 4–6 digit shape rule lives at the action layer (`PIN_PATTERN`);
  /// the string form preserves leading zeros ("0000", "0123").
  /// No index: lookups are by `id`, never by hash.
  pinHash          String
  /// Whether this employee can currently sign in / is staffed. Distinguished
  /// from hard delete so an offboarded cashier's audit trail survives while
  /// their login is revoked — `toggleEmployeeStatus` flips this bit.
  active           Boolean           @default(true)
  role             String            @default("CASHIER")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
     customerPayments CustomerPayment[]
  sales            Sale[]
  shifts           Shift[]
  purchaseOrders   PurchaseOrder[]
  receivedPurchaseOrders PurchaseReceipt[]
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  sku                String              @unique
  price              Float
  cost               Float
  stock              Int
  categoryId         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems          SaleItem[]
  movements          StockMovement[]
  items              TransactionItem[]
  // Phase 1 purchasing: the same Product row can be referenced by many POs; PO-level
  // purchase cost is stored on PurchaseOrderItem.unitCost, not on Product.cost. We do
  // not create a second Product↔Supplier relationship here — Product.supplierId remains
  // the existing optional preferred-supplier link.
  purchaseOrderItems PurchaseOrderItem[]
}

/// A product category. Replaces the old free-text `Product.category` string so
/// the set of categories is governable from the management page: counts, a
/// per-category low-stock threshold (used by the inventory "needs restock"
/// badges and the category page), and rename/delete with idempotent structural
/// changes.
///
/// `lowStockThreshold` overrides the app-wide default (`LOW_STOCK_THRESHOLD` in
/// `src/lib/types.ts`) when set higher; the inventory badge falls back to the
/// default when a category has none or the product is uncategorized. Modeled as
/// a plain `Int @default(10)` rather than a native enum — matching the
/// `Role`/`Sale.status` plain-column + TS-narrowing convention this schema uses
/// throughout (SQLite has no native enum anyway).
model Category {
  id                String    @id @default(uuid())
  name              String    @unique
  /// Per-category "running low" cutoff: a product whose `stock` is strictly
  /// below this is flagged Low Stock (0 is Out of Stock). Defaults to 10, the
  /// app-wide default; raise it for loss-leader categories or lower it for
  /// slow-movers so the inventory alerts match how each line is actually run.
  lowStockThreshold Int       @default(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  products          Product[]
}

model Supplier {
  id             String          @id @default(uuid())
  name           String          @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  // Phase 1 purchasing does not create a new relation here: Supplier is linked to POs
  // through PurchaseOrder.supplierId. This model stays as the existing optional
  // preferred-supplier anchor for Product.supplierId.
  purchaseOrders PurchaseOrder[]
}

model Customer {
  id             String            @id @default(uuid())
  name           String
  email          String?
  phone          String?
  address        String?
  /// Max outstanding debt ("utang") this customer may carry. 0 = no credit
  /// (cash/loyalty only). Enforced at the action layer against `currentBalance`.
  creditLimit    Float             @default(0)
  /// Current outstanding balance. Increased by STORE_CREDIT sales, decreased
  /// by `CustomerPayment` records — kept in sync only inside `$transaction`s.
  /// Bottomed at 0 by the actions that decrement it (never negative).
  currentBalance Float             @default(0)
  /// Free-text note: payment reminders, terms, ID notes, etc. Optional.
  notes          String?
  loyaltyPoints  Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       CustomerPayment[]
  sales          Sale[]
}

/// A debt settlement (payment) applied against a {@link Customer}'s outstanding
/// balance. Complementary to `Sale.paymentMethod = "STORE_CREDIT"`: a credit
/// sale INCREASES `Customer.currentBalance`; a `CustomerPayment` row DECREASES
/// it. Each row records the settled amount, how it was paid (cash, card, GCash),
/// which cashier logged it, and an optional note so the statement view can show
/// the full credit lifecycle (Sales vs. Payments).
///
/// `cashierId` is optional + SetNull so an offboarded cashier's payment records
/// survive (same convention as `Sale.cashierId`). The `amount` is always
/// positive; the balance decrement is applied by the action inside a
/// `$transaction` that writes this row + updates `Customer.currentBalance`
/// atomically. Clamped at 0 — a payment larger than the balance never drives
/// `currentBalance` negative.
model CustomerPayment {
  id            String   @id @default(uuid())
  customerId    String
  /// Amount settled. Always positive.
  amount        Float
  /// How the payment was made — "CASH" | "CARD" | "GCASH" | "OTHER" (plain
  /// String column + TS narrowing, matching this schema's convention).
  paymentMethod String
  /// Cashier (User) who logged the payment. Optional + SetNull preserves the
  /// record if the cashier is later offboarded.
  cashierId     String?
  /// Free-text note (e.g. "Payment on account", "Weekly settle"). Optional.
  notes         String?
  createdAt     DateTime @default(now())
  cashier       User?    @relation(fields: [cashierId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([cashierId])
  @@index([createdAt])
}

model Sale {
  id             String     @id @default(uuid())
  totalAmount    Float
  subtotal       Float
  /// Total monetary discount applied at checkout — the sum of any per-item
  /// and cart-wide discounts the cashier entered. Stored separately so the
  /// ledger can always reconcile `subtotal − discountAmount → taxable →
  /// totalAmount` and so receipts can print a line-item "Discount" row.
  /// `priceAtSale` on `SaleItem` snapshots the *catalog* unit price, so
  /// `subtotal` stays the undiscounted sum (this column carries the delta).
  discountAmount Float      @default(0)
  tax            Float
  paymentMethod  String
  status         String     @default("Completed")
  createdAt      DateTime   @default(now())
  customerId     String?
  cashierId      String?
  /// Free-text reason recorded when the sale was voided (e.g. "Customer cancellation").
  /// Null for non-voided sales.
  voidReason     String?
  /// Timestamp when the sale was voided. Null for non-voided sales.
  voidedAt       DateTime?
  /// User ID of the staff member who processed the void. Null for non-voided sales.
  voidedBy       String?
  /// Loyalty points awarded from this sale. Stored so the void action can reverse
  /// the exact amount originally awarded (rather than recalculating, which may differ
  /// if the points formula changes later). 0 for sales with no customer or no points.
  earnedPoints   Int        @default(0)
  /// Cash-only: amount the customer handed over. Null for non-CASH payments and for
  /// sales recorded before this field existed. Persisted so the void action and any
  /// later cash-audit tooling can reconcile the drawer against the ledger.
  tendered       Float?
  /// Cash-only: change due back to the customer. Null for non-CASH payments.
  change         Float?
  cashier        User?      @relation(fields: [cashierId], references: [id])
  customer       Customer?  @relation(fields: [customerId], references: [id])
  items          SaleItem[]

  @@index([customerId])
  @@index([cashierId])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  quantity    Int
  priceAtSale Float
  product     Product @relation(fields: [productId], references: [id])
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Transaction {
  id            String            @id @default(uuid())
  totalAmount   Float
  subtotal      Float
  tax           Float
  paymentMethod String
  status        String            @default("Completed")
  createdAt     DateTime          @default(now())
  items         TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  priceAtSale   Float
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([productId])
}

/// Append-only audit trail of every stock change for a {@link Product}: a
/// restock, a checkout sale, an inline edit, or a damage write-off. Each row
/// records the signed `quantityChange` (restock +N, sale/damage −N, adjust any
/// sign) and the `type` literal narrowed by `StockMovementType` in
/// `src/lib/types.ts` — the column is a plain `String`, matching this schema's
/// convention for `Role`/`Sale.status`/`Transaction.status` (SQLite has no
/// native enum).
///
/// `productId` is non-nullable with `onDelete: Restrict`, mirroring
/// {@link SaleItem}→`Product` and {@link TransactionItem}→`Product`: an audit
/// row must resist the destruction of the product it records, so a product with
/// any movement history can't be hard-deleted until those rows are cleared. The
/// `Restrict` is the same integrity `deleteProduct`'s P2003 path already covers,
/// extending it from sale/transaction line items to the stock audit trail.
///
/// No backfill — logging begins at go-live; past sales are not reconstructed.
model StockMovement {
  id             String   @id @default(uuid())
  productId      String
  /// Signed change applied to the product's `stock`: positive for restocks,
  /// negative for sales/damage, any sign for a manual adjustment.
  quantityChange Int
  /// Which kind of movement: a `StockMovementType` literal ("RESTOCK" | "SALE"
  /// | "ADJUSTMENT" | "DAMAGE"), narrowed in `src/lib/types.ts` via
  /// `asStockMovementType`.
  type           String
  /// Free-text note carried with the movement (e.g. "Initial stock", "Edit via
  /// inventory", a damage reason). Optional — automated movements may omit it.
  reason         String?
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

/// Store-wide configuration: a single singleton row (the settings page + its
/// server action guarantee at most one row exists). The tax rate and currency
/// symbol here are intended to drive POS checkout and receipts — today those
/// are hardcoded constants (e.g. `TAX_RATE` in `PosCheckout.tsx`); this model
/// externalizes them so the manager can change them without a deploy.
///
/// `updatedAt` is a plain `DateTime` (not `@updatedAt`) so it only moves on an
/// explicit write — the action bumps it manually, and we can read "last edited"
/// from it without Prisma touching it on every unrelated transaction.
model StoreSetting {
  id             String   @id @default(uuid())
  storeName      String
  address        String?
  phone          String?
  /// Sales-tax percentage as a number, e.g. `8.5` means 8.5%. 0 = tax disabled.
  taxRate        Float    @default(0)
  /// Short currency glyph, e.g. "₱", "€", "¥". Kept tiny on purpose.
  currencySymbol String   @default("₱")
  updatedAt      DateTime
}

/// A work shift for an employee (User). Opened by `clockIn` (sets `start`,
/// leaves `end` null = currently clocked in) and closed by `clockOut`
/// (sets `end` and snapshots that shift's sale totals so historical
/// performance is stable and not recomputed against a mutable Sale ledger).
///
/// `totalSales`/`salesCount` are snapshot fields populated at clock-out by
/// summing completed sales attributed to this user whose `createdAt` falls
/// inside [start, end]. They stay 0 for open shifts until closed. Kept as
/// `@default(0)` so a clock-in insert needs no values, matching the
/// plain-column + TS-narrowing convention (no native enum for a "shiftStatus").
model Shift {
  id         String    @id @default(uuid())
  userId     String
  /// Shift start. `@default(now())` so `clockIn` only sends `userId`.
  start      DateTime  @default(now())
  /// Shift end. NULL = the employee is still on the clock. Set by `clockOut`.
  end        DateTime?
  /// Snapshot of total sales $ rung up during this shift, filled at clock-out.
  totalSales Float     @default(0)
  /// Snapshot of the count of completed sales during this shift, at clock-out.
  salesCount Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([start])
}

// Purchase Orders (Phase 1). A PO ties a Supplier to one or more Products with a
// per-line purchase cost snapshot. Phase 1 implements creation, edit, ordering,
// and cancellation only; receiving (stock/movement/receivedQty growth) is Phase 2.
//
// Status vocabulary (stored as a plain String column to match the existing Role /
// Sale.status / Transaction.status convention — SQLite has no native enum):
//   DRAFT              - created, editable
//   ORDERED           - approved/issued to supplier, editable only for expected date + notes
//   PARTIALLY_RECEIVED - future Phase 2 receiving state
//   RECEIVED          - future Phase 2 receiving state
//   CANCELLED         - voided PO; editable only by cancellation path in future phases
//
// PO numbers are allocated atomically from PoNumberCounter and are unique human-
// readable values like "PO-202609-000001". They are generated server-side inside
// the creation transaction, never client-side, and never from a MAX() + 1 read.

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status       String              @default("DRAFT")
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
    items        PurchaseOrderItem[]
  receipts     PurchaseReceipt[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderedQty      Int
  unitCost        Float
    receivedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  receiptItems    PurchaseReceiptItem[]
}

model PoNumberCounter {
  month      String @id // "YYYYMM"
  lastNumber Int    @default(0)
}

// ── Phase 2: Purchase Receiving ────────────────────────────────────────────────
//
// A PurchaseReceipt records one receiving event against an ORDERED (or
// PARTIALLY_RECEIVED) PO. Each receipt carries one-or-more PurchaseReceiptItem
// rows — one per PO line received — and is the audit trail that ties a stock
// increase to a specific PO and a specific actor at a specific time.
//
// Delete behavior:
//   PurchaseReceipt  → PurchaseOrder  RESTRICT  (can't drop a receipt whose PO lives)
//   PurchaseReceipt  → User           RESTRICT  (preserves the actor who received)
//   PurchaseReceiptItem → PurchaseReceipt  CASCADE (items die with their receipt)
//   PurchaseReceiptItem → PurchaseOrderItem  RESTRICT (never orphan the source line)

model PurchaseReceipt {
  id              String                @id @default(uuid())
  purchaseOrderId String
  receivedById    String
  receivedAt      DateTime              @default(now())
  /// Human-readable receiving reference, allocated server-side as
  /// `RCPT-YYYYMM-NNNNNN` (mirrors the PO numbering scheme but on its own
  /// monthly counter so receipts never collide with POs or each other).
  referenceNumber String                @unique
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy      User                  @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items           PurchaseReceiptItem[]
}

model PurchaseReceiptItem {
  id                String           @id @default(uuid())
  purchaseReceiptId String
  purchaseOrderItemId String
  receivedQty       Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  purchaseReceipt   PurchaseReceipt  @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
}

model ReceiptNumberCounter {
  month      String @id // "YYYYMM"
  lastNumber Int    @default(0)
}
