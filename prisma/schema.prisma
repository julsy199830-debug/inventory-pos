// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  /// Numeric login PIN, 4–6 digits. Stored as a string so leading zeros are
  /// preserved (a "0123" PIN must not collapse to "123"). Validated to match
  /// `/^\d{4,6}$/` at the action layer; the schema only commits the shape.
  pin          String
  /// Whether this employee can currently sign in / is staffed. Distinguished
  /// from hard delete so an offboarded cashier's audit trail survives while
  /// their login is revoked — `toggleEmployeeStatus` flips this bit.
  active       Boolean  @default(true)
  // Authorization role. Modeled as a plain `String` column (not a native SQLite
  // enum) to mirror `Sale.status` / `Transaction.status`: the column holds the
  // literal, and the set of allowed values is enforced at the TypeScript layer
  // via the `Role` union in `src/lib/types.ts` ('ADMIN' | 'MANAGER' | 'CASHIER').
  // The default seeds new accounts as the least-privileged 'CASHIER'.
  role         String   @default("CASHIER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Back-relations for the employee performance view. A user's completed sales
  // (the cashier who rang them up) and their worked shifts. Cascade on shift
  // delete is implicit (a User delete removes their shifts — there's no audit
  // value in orphan shift clock-ins once the employee is gone); sales keep their
  // audit trail via the Sale.cashier `onDelete: SetNull` below.
  sales  Sale[]   // sales this cashier rang up (nullable on the Sale side)
  shifts Shift[]  // clock-in/out records for this employee
  // Debt payments this cashier logged against customer balances.
  customerPayments CustomerPayment[]
}

model Product {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  price     Float
  cost      Float
  stock     Int
  // Category link. `categoryId` is nullable so an archive/delete of a category
  // clears the link (onDelete: SetNull) rather than dragging every product with
  // it — see the `Category` model comment. Separated from the old free-text
  // `category` column so the list of categories is now a first-class entity the
  // management page can govern (counts, low-stock thresholds, rename/delete).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One product can appear on many transaction line items.
  items TransactionItem[]

  // A product can appear on many sale line items.
  saleItems SaleItem[]

  // Append-only audit trail of every stock change for this product (restocks,
  // sales, edits, damage). `onDelete: Restrict` on the StockMovement side means
  // a product with any movement history can't be hard-deleted until those rows
  // are removed — same integrity the SaleItem/TransactionItem links enforce, so
  // `deleteProduct`'s P2003 path covers stock movements too. See StockMovement.
  movements StockMovement[]

  // A product may optionally belong to a supplier (nullable). Cascade on
  // delete so removing a supplier clears the link without dropping products.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([categoryId])
}

/// A product category. Replaces the old free-text `Product.category` string so
/// the set of categories is governable from the management page: counts, a
/// per-category low-stock threshold (used by the inventory "needs restock"
/// badges and the category page), and rename/delete with idempotent structural
/// changes.
///
/// `lowStockThreshold` overrides the app-wide default (`LOW_STOCK_THRESHOLD` in
/// `src/lib/types.ts`) when set higher; the inventory badge falls back to the
/// default when a category has none or the product is uncategorized. Modeled as
/// a plain `Int @default(10)` rather than a native enum — matching the
/// `Role`/`Sale.status` plain-column + TS-narrowing convention this schema uses
/// throughout (SQLite has no native enum anyway).
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Per-category "running low" cutoff: a product whose `stock` is strictly
  /// below this is flagged Low Stock (0 is Out of Stock). Defaults to 10, the
  /// app-wide default; raise it for loss-leader categories or lower it for
  /// slow-movers so the inventory alerts match how each line is actually run.
  lowStockThreshold Int     @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Supplier {
  id          String   @id @default(uuid())
  name        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A supplier can provide many products.
  products Product[]
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  address       String?
  /// Max outstanding debt ("utang") this customer may carry. 0 = no credit
  /// (cash/loyalty only). Enforced at the action layer against `currentBalance`.
  creditLimit   Float    @default(0)
  /// Current outstanding balance. Increased by STORE_CREDIT sales, decreased
  /// by `CustomerPayment` records — kept in sync only inside `$transaction`s.
  /// Bottomed at 0 by the actions that decrement it (never negative).
  currentBalance Float   @default(0)
  /// Free-text note: payment reminders, terms, ID notes, etc. Optional.
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // NOTE: intentionally no `@unique` on `email` (or `name`). SQLite treats
  // multiple NULLs as violating a unique constraint, so a unique-on-nullable
  // column would reject the second walk-in customer with no email — clearly
  // wrong. Name collisions are legitimate customer data too (two "John Smith"s).
  //
  // `loyaltyPoints` starts at 0 for new customers and is bumped later, e.g. by
  // a checkout flow or an admin edit. It bottoms out at 0 — never negative.
  //
  // `creditLimit`/`currentBalance` gate the STORE_CREDIT payment method in POS
  // checkout: a sale on account is only allowed when `currentBalance + newTotal
  // <= creditLimit`. `currentBalance` is intentionally NOT derived (a computed
  // read) because the ledger needs an atomic floor for the limit check inside
  // `createSale`'s transaction.

  // A customer's purchases. Optional relation so guest checkouts (no account)
  // can create a Sale with a null customerId.
  sales Sale[]

  // Every debt settlement against this customer's balance. Cascade on customer
  // delete: payments are transactional records of a specific account, not audit
  // rows that must outlive the account (contrast Sale.customerId SetNull).
  payments CustomerPayment[]
}

/// A debt settlement (payment) applied against a {@link Customer}'s outstanding
/// balance. Complementary to `Sale.paymentMethod = "STORE_CREDIT"`: a credit
/// sale INCREASES `Customer.currentBalance`; a `CustomerPayment` row DECREASES
/// it. Each row records the settled amount, how it was paid (cash, card, GCash),
/// which cashier logged it, and an optional note so the statement view can show
/// the full credit lifecycle (Sales vs. Payments).
///
/// `cashierId` is optional + SetNull so an offboarded cashier's payment records
/// survive (same convention as `Sale.cashierId`). The `amount` is always
/// positive; the balance decrement is applied by the action inside a
/// `$transaction` that writes this row + updates `Customer.currentBalance`
/// atomically. Clamped at 0 — a payment larger than the balance never drives
/// `currentBalance` negative.
model CustomerPayment {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Amount settled. Always positive.
  amount        Float
  /// How the payment was made — "CASH" | "CARD" | "GCASH" | "OTHER" (plain
  /// String column + TS narrowing, matching this schema's convention).
  paymentMethod String
  /// Cashier (User) who logged the payment. Optional + SetNull preserves the
  /// record if the cashier is later offboarded.
  cashierId     String?
  cashier       User?    @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  /// Free-text note (e.g. "Payment on account", "Weekly settle"). Optional.
  notes         String?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([cashierId])
  @@index([createdAt])
}

model Sale {
  id            String   @id @default(uuid())
  totalAmount   Float
  subtotal      Float
  tax           Float
  paymentMethod String
  status        String   @default("Completed")
  createdAt     DateTime @default(now())

  // Optional link to a Customer — null for guest checkouts. SetNull keeps the
  // sale record intact if the customer is later deleted (audit trail preserved).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Optional link to the cashier (User) who rang up this sale. Null for
  // legacy/guest sales made before cashier attribution existed, and SetNull
  // preserves an offboarded cashier's audit trail just like `customerId` — the
  // User.* `active` comment calls this out explicitly. Drives per-employee
  // sales metrics in the Employees module.
  cashierId String?
  cashier   User? @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  // A sale owns many line items; deleting a sale removes its items to keep the
  // ledger consistent.
  items SaleItem[]

  @@index([customerId])
  @@index([cashierId])
}

model SaleItem {
  id      String @id @default(uuid())
  saleId  String
  productId String
  quantity Int
  priceAtSale Float

  // Snapshotted connection between a Sale and a Product. Cascade on sale
  // delete; Restrict on product delete so product removal can't silently drop
  // sale history.
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Transaction {
  id            String   @id @default(uuid())
  totalAmount   Float
  subtotal      Float
  tax           Float
  paymentMethod String
  status        String   @default("Completed")
  createdAt     DateTime @default(now())

  // A transaction owns many line items; deleting a transaction
  // removes its items to keep the ledger consistent.
  items TransactionItem[]
}

model TransactionItem {
  id            String @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  priceAtSale   Float

  // Snapshotted connection between a Transaction and a Product.
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
}

/// Append-only audit trail of every stock change for a {@link Product}: a
/// restock, a checkout sale, an inline edit, or a damage write-off. Each row
/// records the signed `quantityChange` (restock +N, sale/damage −N, adjust any
/// sign) and the `type` literal narrowed by `StockMovementType` in
/// `src/lib/types.ts` — the column is a plain `String`, matching this schema's
/// convention for `Role`/`Sale.status`/`Transaction.status` (SQLite has no
/// native enum).
///
/// `productId` is non-nullable with `onDelete: Restrict`, mirroring
/// {@link SaleItem}→`Product` and {@link TransactionItem}→`Product`: an audit
/// row must resist the destruction of the product it records, so a product with
/// any movement history can't be hard-deleted until those rows are cleared. The
/// `Restrict` is the same integrity `deleteProduct`'s P2003 path already covers,
/// extending it from sale/transaction line items to the stock audit trail.
///
/// No backfill — logging begins at go-live; past sales are not reconstructed.
model StockMovement {
  id             String   @id @default(uuid())
  productId      String
  /// Signed change applied to the product's `stock`: positive for restocks,
  /// negative for sales/damage, any sign for a manual adjustment.
  quantityChange Int
  /// Which kind of movement: a `StockMovementType` literal ("RESTOCK" | "SALE"
  /// | "ADJUSTMENT" | "DAMAGE"), narrowed in `src/lib/types.ts` via
  /// `asStockMovementType`.
  type           String
  /// Free-text note carried with the movement (e.g. "Initial stock", "Edit via
  /// inventory", a damage reason). Optional — automated movements may omit it.
  reason         String?
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
}

/// Store-wide configuration: a single singleton row (the settings page + its
/// server action guarantee at most one row exists). The tax rate and currency
/// symbol here are intended to drive POS checkout and receipts — today those
/// are hardcoded constants (e.g. `TAX_RATE` in `PosCheckout.tsx`); this model
/// externalizes them so the manager can change them without a deploy.
///
/// `updatedAt` is a plain `DateTime` (not `@updatedAt`) so it only moves on an
/// explicit write — the action bumps it manually, and we can read "last edited"
/// from it without Prisma touching it on every unrelated transaction.
model StoreSetting {
  id        String @id @default(uuid())
  storeName String
  address   String?
  phone     String?
  /// Sales-tax percentage as a number, e.g. `8.5` means 8.5%. 0 = tax disabled.
  taxRate   Float  @default(0)
  /// Short currency glyph, e.g. "₱", "€", "¥". Kept tiny on purpose.
  currencySymbol String @default("₱")
  updatedAt DateTime
}

/// A work shift for an employee (User). Opened by `clockIn` (sets `start`,
/// leaves `end` null = currently clocked in) and closed by `clockOut`
/// (sets `end` and snapshots that shift's sale totals so historical
/// performance is stable and not recomputed against a mutable Sale ledger).
///
/// `totalSales`/`salesCount` are snapshot fields populated at clock-out by
/// summing completed sales attributed to this user whose `createdAt` falls
/// inside [start, end]. They stay 0 for open shifts until closed. Kept as
/// `@default(0)` so a clock-in insert needs no values, matching the
/// plain-column + TS-narrowing convention (no native enum for a "shiftStatus").
model Shift {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shift start. `@default(now())` so `clockIn` only sends `userId`.
  start      DateTime @default(now())
  /// Shift end. NULL = the employee is still on the clock. Set by `clockOut`.
  end        DateTime?
  /// Snapshot of total sales $ rung up during this shift, filled at clock-out.
  totalSales Float   @default(0)
  /// Snapshot of the count of completed sales during this shift, at clock-out.
  salesCount Int     @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([start])
}